{
  "name": "pf2e-stockfish",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Foundry VTT module: tactical evaluation and best-move search for Pathfinder 2e combats.",
  "scripts": {
    "wasm": "../scripts/build-wasm.sh",
    "build": "vite build && node scripts/assemble.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "package": "npm run build && node scripts/package.mjs",
    "smoke": "node scripts/browser-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
